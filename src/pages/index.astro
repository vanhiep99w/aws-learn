<!-- GSAP -->
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script is:inline>
(function(){
  // Respect prefers-reduced-motion
  if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  gsap.registerPlugin(ScrollTrigger);
  const ease = 'power3.out';

  // ══════ INTRO BACKGROUND ══════
  // Scattered twinkling stars
  (function(){
    var sc = document.getElementById('intro-stars');
    if(!sc) return;
    for(var i=0;i<50;i++){
      var s = document.createElement('div');
      s.className = 'intro-star';
      var size = 1 + Math.random()*2;
      s.style.width = size+'px';
      s.style.height = size+'px';
      s.style.left = Math.random()*100+'%';
      s.style.top = Math.random()*100+'%';
      sc.appendChild(s);
      // Twinkle: fade in/out at random times
      gsap.to(s, {
        opacity:.3+Math.random()*.7,
        duration:.6+Math.random()*1,
        delay:Math.random()*1.5,
        ease:'power1.in'
      });
      gsap.to(s, {
        opacity:0, duration:.5+Math.random()*.8,
        repeat:-1, yoyo:true,
        delay:1+Math.random()*2,
        ease:'sine.inOut'
      });
    }
  })();

  // Glow orbs — breathe in/out
  gsap.to('.intro-glow-1', {opacity:.8, scale:1.2, duration:2, ease:'sine.inOut', repeat:-1, yoyo:true});
  gsap.to('.intro-glow-2', {opacity:.6, scale:1.3, duration:2.5, delay:.5, ease:'sine.inOut', repeat:-1, yoyo:true, x:20, y:-15});

  // ══════ A. PAGE INTRO ══════
  const introTl = gsap.timeline({
    onComplete(){
      document.querySelector('.intro').style.pointerEvents = 'none';
      runEntrance();
    }
  });

  introTl
    // Dot appears with punch
    .to('.intro-dot', {scale:1, duration:.5, ease:'back.out(3)'})
    // Rings expand outward
    .to('.intro-ring', {scale:1, opacity:1, duration:.6, ease:'power2.out', stagger:.12}, '-=.2')
    // Rings pulse once
    .to('.intro-ring', {scale:1.15, opacity:0, duration:.5, ease:'power1.in', stagger:.08}, '+=.1')
    // Text fades up with gradient
    .to('.intro-text', {opacity:1, y:0, duration:.5, ease}, '-=.4')
    // Tagline follows
    .to('.intro-tagline', {opacity:1, y:0, duration:.4, ease}, '-=.2')
    // Line sweeps across
    .to('.intro-line', {width:120, duration:.4, ease:'power2.inOut'}, '-=.1')
    // Hold for a beat, then exit
    .to('.intro-content', {opacity:0, y:-30, duration:.35, ease:'power2.in'}, '+=.4')
    .to('.intro', {yPercent:-100, duration:.55, ease:'power3.inOut'}, '-=.15');

  // ══════ B. TEXT REVEAL + ENTRANCE ══════
  function runEntrance(){
    const entranceTl = gsap.timeline({defaults:{ease}});

    // Hero left — robot slide in
    entranceTl.to('.hero-left', {opacity:1, x:0, scale:1, duration:.9});

    // Overline — typewriter-style
    entranceTl.to('.hero-right .overline', {opacity:1, y:0, duration:.5}, '-=.6');

    // Split text chars — stagger
    entranceTl.to('.char', {opacity:1, y:0, duration:.5, stagger:.03, ease:'back.out(1.4)'}, '-=.3');

    // Paragraph, buttons
    entranceTl.to('.hero-right p', {opacity:1, y:0, duration:.5}, '-=.2');
    entranceTl.to('.btns', {opacity:1, y:0, duration:.5}, '-=.3');

    // Stats
    entranceTl.to('.stats', {opacity:1, y:0, duration:.6}, '-=.2');

    // Topics
    entranceTl.to('.topics', {opacity:1, y:0, duration:.6}, '-=.3');
  }

  // ══════ C. PARALLAX SCROLLING ══════
  gsap.to('.wave-1', {
    y: -120, rotation: 15,
    scrollTrigger:{trigger:'body', start:'top top', end:'bottom bottom', scrub:1.5}
  });
  gsap.to('.wave-2', {
    y: 100, rotation: -10,
    scrollTrigger:{trigger:'body', start:'top top', end:'bottom bottom', scrub:2}
  });

  // Aurora parallax — slower drift
  gsap.to('.aurora-1', {
    y:-80, x:40,
    scrollTrigger:{trigger:'body', start:'top top', end:'bottom bottom', scrub:3}
  });
  gsap.to('.aurora-2', {
    y:60, x:-30,
    scrollTrigger:{trigger:'body', start:'top top', end:'bottom bottom', scrub:2.5}
  });

  // Grid + aurora fade in after intro
  gsap.to('.grid-bg', {opacity:1, duration:1.5, delay:.3, ease:'power1.in'});
  gsap.to('.aurora', {opacity:1, duration:1.5, delay:.3, stagger:.3, ease:'power1.in'});

  // ══════ E. GLOW ORBS ══════
  // Fade in
  gsap.to('.glow-orb', {opacity:1, duration:2, delay:.5, stagger:.4, ease:'power1.in'});
  // Slow drifting movement
  document.querySelectorAll('.glow-orb').forEach(function(orb, i){
    gsap.to(orb, {
      x: 40 + i*20, y: -30 + i*15,
      duration: 10 + i*4,
      repeat:-1, yoyo:true, ease:'sine.inOut'
    });
    // Pulsing scale
    gsap.to(orb, {
      scale: 1.3 - i*.1,
      duration: 5 + i*2,
      repeat:-1, yoyo:true, ease:'sine.inOut',
      delay: i*1.5
    });
  });
  // Orbs parallax
  gsap.to('.glow-orb-1', {y:-100, scrollTrigger:{trigger:'body', start:'top top', end:'bottom bottom', scrub:2}});
  gsap.to('.glow-orb-2', {y:80, scrollTrigger:{trigger:'body', start:'top top', end:'bottom bottom', scrub:3}});
  gsap.to('.glow-orb-3', {y:-60, scrollTrigger:{trigger:'body', start:'top top', end:'bottom bottom', scrub:1.5}});

  // ══════ F. SHOOTING STARS ══════
  (function(){
    var meteorsContainer = document.getElementById('meteors');
    if(!meteorsContainer) return;

    function launchMeteor(){
      var mc = meteorsContainer;
      var W = mc.offsetWidth, H = mc.offsetHeight;
      var sx, sy;
      if(Math.random()>0.4){
        sx = W * (0.1 + Math.random()*0.85);
        sy = -10 + Math.random() * H * 0.1;
      } else {
        sx = W * (0.85 + Math.random()*0.15);
        sy = Math.random() * H * 0.5;
      }
      var angle = (210 + Math.random()*20) * Math.PI / 180;
      var totalDist = Math.sqrt(W*W + H*H) * (0.7 + Math.random()*0.3);
      var duration = 3 + Math.random()*2;

      var head = document.createElement('div');
      head.className = 'meteor-head';
      head.style.left = sx + 'px';
      head.style.top = sy + 'px';
      mc.appendChild(head);

      var dx = Math.cos(angle) * totalDist;
      var dy = -Math.sin(angle) * totalDist;

      // Animate head
      gsap.fromTo(head, {opacity:0}, {opacity:1, duration:.2});
      gsap.to(head, {
        x:dx, y:dy, duration:duration, ease:'none',
        onComplete:function(){head.remove()}
      });
      gsap.to(head, {opacity:0, duration:.5, delay:duration-.5});

      // Trail — round soft dots with glow, color gradient
      var trailCount = 45;
      var trailColors = [
        {bg:'rgba(255,255,255,',glow:'rgba(255,255,255,'},
        {bg:'rgba(180,230,255,',glow:'rgba(150,210,255,'},
        {bg:'rgba(140,160,255,',glow:'rgba(120,140,250,'},
        {bg:'rgba(167,139,250,',glow:'rgba(167,139,250,'},
        {bg:'rgba(236,72,153,', glow:'rgba(236,72,153,'}
      ];
      function getColor(idx){
        if(idx<6) return trailColors[0];
        if(idx<13) return trailColors[1];
        if(idx<21) return trailColors[2];
        if(idx<31) return trailColors[3];
        return trailColors[4];
      }

      for(var i=0;i<trailCount;i++){
        (function(idx){
          setTimeout(function(){
            var progress = idx/trailCount;
            var tx = sx + dx*progress;
            var ty = sy + dy*progress;
            var tc = getColor(idx);

            // Round dot with soft glow
            var dot = document.createElement('div');
            dot.className = 'meteor-trail';
            var size = 5 - progress*4; if(size<1.5) size=1.5;
            dot.style.width = size+'px';
            dot.style.height = size+'px';
            var op = 1 - progress*0.4;
            dot.style.background = 'radial-gradient(circle,'+tc.bg+op+') 0%,'+tc.bg+(op*.3)+') 60%,transparent 100%)';
            dot.style.boxShadow = '0 0 '+(12-progress*10)+'px '+(4-progress*3)+'px '+tc.glow+'0.5)';
            dot.style.left = tx+'px';
            dot.style.top = ty+'px';
            // Make visual size larger with the glow
            dot.style.width = (size+6-progress*4)+'px';
            dot.style.height = (size+6-progress*4)+'px';
            mc.appendChild(dot);
            gsap.to(dot, {opacity:0, scale:0, duration:2+progress*1.5, ease:'power1.out',
              onComplete:function(){dot.remove()}
            });

            // Sparkle every 4th dot
            if(idx%4===0 && idx<28){
              var sp = document.createElement('div');
              sp.className = 'meteor-sparkle';
              var spSize = 2 - progress*1.5; if(spSize<0.5) spSize=0.5;
              sp.style.width = spSize+'px';
              sp.style.height = spSize+'px';
              sp.style.left = tx+'px';
              sp.style.top = ty+'px';
              sp.style.opacity = '0';
              sp.style.boxShadow = '0 0 4px '+tc.glow+'0.8)';
              mc.appendChild(sp);
              var drift = (Math.random()-.5)*25;
              var driftX = Math.cos(angle+Math.PI/2)*drift;
              var driftY = -Math.sin(angle+Math.PI/2)*drift;
              gsap.to(sp, {opacity:.6, duration:.15});
              gsap.to(sp, {x:driftX, y:driftY, opacity:0, scale:0, duration:.8+Math.random()*.8,
                ease:'power1.out', delay:.1,
                onComplete:function(){sp.remove()}
              });
            }
          }, idx*(duration*1000/trailCount));
        })(i);
      }
    }

    // Only 1 meteor at a time
    function scheduleMeteor(){
      var delay = 4000 + Math.random()*6000;
      setTimeout(function(){
        launchMeteor();
        scheduleMeteor();
      }, delay);
    }
    setTimeout(function(){
      launchMeteor();
      scheduleMeteor();
    }, 3000);
  })();

  // ══════ G. FLOATING PARTICLES ══════
  (function(){
    var container = document.getElementById('particles');
    if(!container) return;
    var colors = [
      'rgba(167,139,250,.4)',
      'rgba(236,72,153,.35)',
      'rgba(34,211,238,.3)',
      'rgba(251,191,36,.3)',
      'rgba(110,231,183,.3)'
    ];
    var count = 25;
    for(var i=0;i<count;i++){
      var el = document.createElement('div');
      el.className = 'particle';
      var size = 3 + Math.random()*5;
      el.style.width = size+'px';
      el.style.height = size+'px';
      el.style.setProperty('--p-color', colors[i % colors.length]);
      el.style.left = Math.random()*100+'%';
      el.style.top = Math.random()*100+'%';
      container.appendChild(el);

      // Each particle floats independently
      gsap.to(el, {
        opacity: .4 + Math.random()*.4,
        duration: 1 + Math.random()*2,
        delay: Math.random()*3,
        ease:'power1.in'
      });
      gsap.to(el, {
        y: -(60 + Math.random()*120),
        x: -30 + Math.random()*60,
        duration: 8 + Math.random()*12,
        repeat:-1,
        yoyo:true,
        ease:'sine.inOut',
        delay: Math.random()*5
      });
    }

    // Particles parallax
    gsap.to('#particles', {
      y:-50,
      scrollTrigger:{trigger:'body', start:'top top', end:'bottom bottom', scrub:1}
    });
  })();

  // Stats — float up on scroll
  ScrollTrigger.create({
    trigger:'.stats',
    start:'top 85%',
    onEnter(){
      gsap.to('.stat-card', {y:-8, duration:.8, stagger:.1, ease});
    },
    once:true
  });

  // Topic cards — stagger in on scroll
  ScrollTrigger.create({
    trigger:'.tg',
    start:'top 80%',
    onEnter(){
      gsap.to('.tc', {
        y:0, opacity:1, duration:.6,
        stagger:{amount:.4, from:'start'},
        ease
      });
    },
    once:true
  });

  // Set topic cards initial for scroll reveal
  gsap.set('.tc', {y:30, opacity:0});

  // ══════ D. MOUSE-FOLLOW EFFECTS ══════

  // Magnetic buttons
  document.querySelectorAll('.b-glow, .b-glass').forEach(function(btn){
    var rect;
    btn.addEventListener('mouseenter', function(){rect = btn.getBoundingClientRect()});
    btn.addEventListener('mousemove', function(e){
      if(!rect) return;
      var x = e.clientX - rect.left - rect.width/2;
      var y = e.clientY - rect.top - rect.height/2;
      gsap.to(btn, {x:x*.25, y:y*.35, duration:.3, ease:'power2.out'});
    });
    btn.addEventListener('mouseleave', function(){
      gsap.to(btn, {x:0, y:0, duration:.5, ease:'elastic.out(1,.4)'});
    });
  });

  // Tilt cards
  document.querySelectorAll('.tc').forEach(function(card){
    var rect;
    card.style.transformStyle = 'preserve-3d';
    card.addEventListener('mouseenter', function(){rect = card.getBoundingClientRect()});
    card.addEventListener('mousemove', function(e){
      if(!rect) return;
      var x = (e.clientX - rect.left) / rect.width - .5;
      var y = (e.clientY - rect.top) / rect.height - .5;
      gsap.to(card, {
        rotateY: x * 12,
        rotateX: y * -8,
        duration:.4,
        ease:'power2.out',
        transformPerspective:600
      });
    });
    card.addEventListener('mouseleave', function(){
      gsap.to(card, {rotateY:0, rotateX:0, duration:.6, ease:'elastic.out(1,.5)'});
    });
  });

})();
</script>

</body>
</html>
