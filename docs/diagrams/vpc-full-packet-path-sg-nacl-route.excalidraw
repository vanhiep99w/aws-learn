    {"type":"text","id":"rule_text","x":70,"y":142,"width":2240,"height":40,"text":"Rule cần nhớ: NACL kiểm từng packet ở subnet boundary và match DESTINATION port. Security Group gắn vào ENI/instance và stateful: response traffic tự được allow theo connection tracking.","originalText":"Rule cần nhớ: NACL kiểm từng packet ở subnet boundary và match DESTINATION port. Security Group gắn vào ENI/instance và stateful: response traffic tự được allow theo connection tracking.","fontSize":17,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#92400e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":210007,"version":1,"versionNonce":210008,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

