    {"type":"text","id":"title","x":40,"y":35,"width":2200,"height":42,"text":"Bastion SSH → Private EC2: full packet path qua SG, NACL, Route Table, VPC Router","originalText":"Bastion SSH → Private EC2: full packet path qua SG, NACL, Route Table, VPC Router","fontSize":30,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":210001,"version":1,"versionNonce":210002,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"subtitle","x":40,"y":82,"width":2200,"height":24,"text":"Mục tiêu: thấy chính xác packet đi qua OUTBOUND/INBOUND rule nào, route table nào được lookup, và vì sao response dùng ephemeral port.","originalText":"Mục tiêu: thấy chính xác packet đi qua OUTBOUND/INBOUND rule nào, route table nào được lookup, và vì sao response dùng ephemeral port.","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":210003,"version":1,"versionNonce":210004,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
