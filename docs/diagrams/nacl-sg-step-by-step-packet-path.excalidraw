    {"type":"text","id":"rule_banner_text","x":80,"y":143,"width":1820,"height":26,"text":"NACL = stateless nên phải allow cả request và response. SG = stateful nên response được auto-allow nếu request đã được allow.","originalText":"NACL = stateless nên phải allow cả request và response. SG = stateful nên response được auto-allow nếu request đã được allow.","fontSize":18,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#92400e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":110007,"version":1,"versionNonce":110008,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

