    {"type":"text","id":"title","x":50,"y":35,"width":1800,"height":42,"text":"Bastion SSH → Private EC2: packet đi qua từng Security Group và từng NACL","originalText":"Bastion SSH → Private EC2: packet đi qua từng Security Group và từng NACL","fontSize":30,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":110001,"version":1,"versionNonce":110002,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"subtitle","x":50,"y":82,"width":1800,"height":24,"text":"Đọc từ trái sang phải cho REQUEST, rồi từ phải sang trái cho RESPONSE. Mỗi checkpoint ghi rõ IN/OUT và destination port mà rule phải allow.","originalText":"Đọc từ trái sang phải cho REQUEST, rồi từ phải sang trái cho RESPONSE. Mỗi checkpoint ghi rõ IN/OUT và destination port mà rule phải allow.","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":110003,"version":1,"versionNonce":110004,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

