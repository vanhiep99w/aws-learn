    {"type":"rectangle","id":"summary_box","x":70,"y":940,"width":570,"height":175,"strokeColor":"#1e293b","backgroundColor":"#1e293b","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":180001,"version":1,"versionNonce":180002,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"summary_text","x":95,"y":963,"width":520,"height":125,"text":"Flow thật sự\n\nREQUEST:\nEC2 → SG OUT → NACL OUT → local route\n→ NACL IN → SG IN → EC2\n\nRESPONSE:\nEC2 → SG OUT → NACL OUT → local route\n→ NACL IN → SG IN → EC2","originalText":"Flow thật sự\n\nREQUEST:\nEC2 → SG OUT → NACL OUT → local route\n→ NACL IN → SG IN → EC2\n\nRESPONSE:\nEC2 → SG OUT → NACL OUT → local route\n→ NACL IN → SG IN → EC2","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":180003,"version":2,"versionNonce":180004,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"rectangle","id":"key_box","x":690,"y":940,"width":570,"height":175,"strokeColor":"#1e293b","backgroundColor":"#1e293b","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":180005,"version":1,"versionNonce":180006,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"key_text","x":715,"y":963,"width":520,"height":125,"text":"Port rule cần nhớ\n\nNACL kiểm DESTINATION port:\n- request dst = 22\n- response dst = 45678 ephemeral\n\nSG có connection tracking nên response auto allowed.","originalText":"Port rule cần nhớ\n\nNACL kiểm DESTINATION port:\n- request dst = 22\n- response dst = 45678 ephemeral\n\nSG có connection tracking nên response auto allowed.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":180007,"version":1,"versionNonce":180008,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"rectangle","id":"mistake_box","x":1310,"y":940,"width":570,"height":175,"strokeColor":"#b91c1c","backgroundColor":"#fee2e2","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":180009,"version":1,"versionNonce":180010,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"mistake_text","x":1335,"y":963,"width":520,"height":125,"text":"Chỗ dễ nhầm\n\nResponse có SOURCE port 22.\nNhưng NACL IN của public subnet\nkhông nhìn source port.\nNó match DESTINATION port = 45678.\n\nVì vậy facing NACL IN phải mở ephemeral.","originalText":"Chỗ dễ nhầm\n\nResponse có SOURCE port 22.\nNhưng NACL IN của public subnet\nkhông nhìn source port.\nNó match DESTINATION port = 45678.\n\nVì vậy facing NACL IN phải mở ephemeral.","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#7f1d1d","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":180011,"version":2,"versionNonce":180012,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25}
