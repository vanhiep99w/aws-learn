    {"type":"text","id":"packet_title","x":85,"y":1230,"width":590,"height":26,"text":"Packet anatomy — 1 kết nối SSH có 2 chiều khác port đích","originalText":"Packet anatomy — 1 kết nối SSH có 2 chiều khác port đích","fontSize":16,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#ffffff","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400003,"version":1,"versionNonce":400004,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"packet_code","x":85,"y":1270,"width":590,"height":160,"text":"FORWARD\n  src = bastion 10.0.1.76:45678\n  dst = server  10.0.3.57:22\n  service subnet IN sees destination port 22\n\nRETURN\n  src = server  10.0.3.57:22\n  dst = bastion 10.0.1.76:45678\n  facing subnet IN sees destination port 45678","originalText":"FORWARD\n  src = bastion 10.0.1.76:45678\n  dst = server  10.0.3.57:22\n  service subnet IN sees destination port 22\n\nRETURN\n  src = server  10.0.3.57:22\n  dst = bastion 10.0.1.76:45678\n  facing subnet IN sees destination port 45678","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400005,"version":1,"versionNonce":400006,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

    {"type":"rectangle","id":"rules_box","x":740,"y":1210,"width":610,"height":250,"strokeColor":"#1e293b","backgroundColor":"#1e293b","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400007,"version":1,"versionNonce":400008,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"rules_title","x":765,"y":1230,"width":560,"height":26,"text":"Rule set tối thiểu để SSH thông","originalText":"Rule set tối thiểu để SSH thông","fontSize":16,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#ffffff","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400009,"version":1,"versionNonce":400010,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"rules_code","x":765,"y":1270,"width":560,"height":162,"text":"Security Groups\n  bastion-SG OUT: TCP 22 → service-SG\n  service-SG IN : TCP 22 ← bastion-SG\n\nNetwork ACLs\n  facing OUT : dst 22 → 10.0.3.0/24\n  service IN : dst 22 ← 10.0.1.0/24\n  service OUT: dst 32768-65535 → 10.0.1.0/24\n  facing IN : dst 32768-65535 ← 10.0.3.0/24","originalText":"Security Groups\n  bastion-SG OUT: TCP 22 → service-SG\n  service-SG IN : TCP 22 ← bastion-SG\n\nNetwork ACLs\n  facing OUT : dst 22 → 10.0.3.0/24\n  service IN : dst 22 ← 10.0.1.0/24\n  service OUT: dst 32768-65535 → 10.0.1.0/24\n  facing IN : dst 32768-65535 ← 10.0.3.0/24","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400011,"version":1,"versionNonce":400012,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

    {"type":"rectangle","id":"mental_model","x":1390,"y":1210,"width":630,"height":250,"strokeColor":"#b91c1c","backgroundColor":"#fee2e2","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400013,"version":1,"versionNonce":400014,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"mental_title","x":1415,"y":1230,"width":580,"height":26,"text":"Điểm dễ nhầm nhất","originalText":"Điểm dễ nhầm nhất","fontSize":16,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#b91c1c","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400015,"version":1,"versionNonce":400016,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"mental_text","x":1415,"y":1270,"width":580,"height":145,"text":"Sai mental model:\n  \"server trả lời từ port 22 nên facing inbound mở 22\"\n\nĐúng mental model:\n  NACL inbound nhìn destination port.\n  Return packet đi VÀO facing subnet có destination = bastion:45678.\n  Vì vậy phải mở ephemeral từ 10.0.3.0/24.","originalText":"Sai mental model:\n  \"server trả lời từ port 22 nên facing inbound mở 22\"\n\nĐúng mental model:\n  NACL inbound nhìn destination port.\n  Return packet đi VÀO facing subnet có destination = bastion:45678.\n  Vì vậy phải mở ephemeral từ 10.0.3.0/24.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#7f1d1d","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400017,"version":1,"versionNonce":400018,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25}
  ],
