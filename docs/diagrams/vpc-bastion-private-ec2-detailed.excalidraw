    {"type":"text","id":"argument_text","x":85,"y":151,"width":1900,"height":50,"text":"NACL là stateless: mỗi packet bị kiểm độc lập ở cả chiều ra và chiều vào subnet. Rule Port range trong NACL match DESTINATION PORT của packet đang đi qua boundary.","originalText":"NACL là stateless: mỗi packet bị kiểm độc lập ở cả chiều ra và chiều vào subnet. Rule Port range trong NACL match DESTINATION PORT của packet đang đi qua boundary.","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"middle","strokeColor":"#92400e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":100007,"version":1,"versionNonce":100008,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

