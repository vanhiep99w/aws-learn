    {"type":"text","id":"evidence_ports_text","x":95,"y":1038,"width":455,"height":120,"text":"Port thực tế của 1 SSH connection\n\nREQUEST  : bastion:45678 → ec2:22\nRESPONSE : ec2:22       → bastion:45678\n\n45678 là ví dụ ephemeral port do client chọn.","originalText":"Port thực tế của 1 SSH connection\n\nREQUEST  : bastion:45678 → ec2:22\nRESPONSE : ec2:22       → bastion:45678\n\n45678 là ví dụ ephemeral port do client chọn.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":104003,"version":1,"versionNonce":104004,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"rectangle","id":"evidence_rules","x":610,"y":1015,"width":500,"height":170,"strokeColor":"#1e293b","backgroundColor":"#1e293b","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":104005,"version":1,"versionNonce":104006,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"evidence_rules_text","x":635,"y":1038,"width":455,"height":120,"text":"NACL rules tối thiểu cho Bastion → Private EC2\n\npublic OUT  : dst 22            → 10.0.3.0/24\nprivate IN  : dst 22            ← 10.0.1.0/24\nprivate OUT : dst 32768-65535   → 10.0.1.0/24\npublic IN   : dst 32768-65535   ← 10.0.3.0/24","originalText":"NACL rules tối thiểu cho Bastion → Private EC2\n\npublic OUT  : dst 22            → 10.0.3.0/24\nprivate IN  : dst 22            ← 10.0.1.0/24\nprivate OUT : dst 32768-65535   → 10.0.1.0/24\npublic IN   : dst 32768-65535   ← 10.0.3.0/24","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":104007,"version":1,"versionNonce":104008,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"rectangle","id":"mistake_box","x":1150,"y":1015,"width":480,"height":170,"strokeColor":"#b91c1c","backgroundColor":"#fee2e2","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":104009,"version":1,"versionNonce":104010,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"mistake_text","x":1175,"y":1038,"width":435,"height":125,"text":"Chỗ dễ sai\n\nResponse KHÔNG có destination port 22.\nNó có source port 22, nhưng destination\nlà bastion ephemeral port 45678.\n\nVì vậy public/facing NACL IN phải mở ephemeral.","originalText":"Chỗ dễ sai\n\nResponse KHÔNG có destination port 22.\nNó có source port 22, nhưng destination\nlà bastion ephemeral port 45678.\n\nVì vậy public/facing NACL IN phải mở ephemeral.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#7f1d1d","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":104011,"version":2,"versionNonce":104012,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25}
